cmd-delaystart-desc = Retrasa el inicio de la ronda.

cmd-delaystart-help = Uso: delaystart [segundos]
                      Si no se pasan argumentos, la ronda se pausará o se reanudará según corresponda.

cmd-delaystart-invalid-seconds = {$value} no es una cantidad válida de segundos.

cmd-delaystart-paused = Cuenta atrás pausada.

cmd-delaystart-unpaused = Cuenta atrás reanudada.

cmd-delaystart-too-late = ¡No se pudo retrasar el inicio de la ronda a tiempo!
