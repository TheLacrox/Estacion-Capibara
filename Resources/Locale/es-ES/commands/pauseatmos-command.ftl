cmd-pauseatmos-desc = Pausa o reanuda la simulación de la atmósfera para la entidad de cuadrícula indicada.

cmd-pauseatmos-help = Uso: {$command} <EntityUid>

cmd-pauseatmos-set-atmos-simulation = Simulación de atmosféricos en {$grid} establecida en el estado {$state}.

cmd-pauseatmos-completion-grid-pause = EntityUid de la cuadrícula que quieres pausar o reanudar. Si se deja vacío, usa automáticamente la cuadrícula sobre la que estás.
