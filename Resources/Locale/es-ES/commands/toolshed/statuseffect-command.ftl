command-description-statuseffect-add =
    Añade tiempo en segundos a la duración de un efecto de estado dado, o crea uno con una duración igual al tiempo.

command-description-statuseffect-update =
    Establece la duración de un efecto de estado al mayor valor entre el tiempo introducido y el tiempo existente. Si el tiempo es 0, la duración será infinita.

command-description-statuseffect-set =
    Establece la duración de un efecto de estado al tiempo introducido en segundos. Si el tiempo es 0, la duración será infinita.

command-description-statuseffect-remove =
    Elimina tiempo de un efecto de estado dado por prototipo. Si no se indica el tiempo, elimina el efecto de estado.
