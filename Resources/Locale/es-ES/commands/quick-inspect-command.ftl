cmd-quickinspect-desc = Define el nombre de un componente que se abrirá para la entidad bajo el cursor mediante la tecla "Inspeccionar componente de servidor/cliente".

cmd-quickinspect-help = Uso: {$command} <nombre del componente>

cmd-quickinspect-success = Componente establecido en: {$component}.
    Pulsa {$serverKeybind} para abrir una ventana VV del servidor.
    Pulsa {$clientKeybind} para abrir una ventana VV del cliente.
