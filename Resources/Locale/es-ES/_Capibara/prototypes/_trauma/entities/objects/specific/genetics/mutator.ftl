ent-GeneticsMutator = mutador
    .desc = Un inyector de un solo uso de un mutágeno diseñado para replicar un gen específico por todo el cuerpo.

ent-GeneticsActivator = activador
    .desc = Un inyector de un solo uso de un mutágeno que puede activar una mutación latente sin aumentar la inestabilidad.

ent-GeneticsCleanser = limpiador
    .desc = Un inyector de un solo uso de un mutágeno diseñado para eliminar y desactivar la expresión de un gen específico del cuerpo.
