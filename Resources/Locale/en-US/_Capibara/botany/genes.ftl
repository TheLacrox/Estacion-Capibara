# Legendary genes
capibara-gene-bluespace-anomaly-name = Bluespace Anomaly
capibara-gene-bluespace-anomaly-desc = Produce creates unstable two-way portals on impact. Extremely dangerous.

capibara-gene-plasma-core-name = Plasma Core
capibara-gene-plasma-core-desc = Produce burns with plasma fire. Immune to cold. Sets things ablaze.

capibara-gene-singularity-seed-name = Singularity Seed
capibara-gene-singularity-seed-desc = Produce creates a micro-gravity well, pulling entities toward it for 5 seconds.

capibara-gene-temporal-name = Temporal
capibara-gene-temporal-desc = Produce slows time in the area on impact. Halves maturation and production time.

