<controls:FancyWindow
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    Title="{Loc 'capibara-plant-analyzer-title'}"
    MinSize="380 560"
    SetSize="400 600">

    <ScrollContainer VerticalExpand="True" HorizontalExpand="True" Margin="0 0 0 0">
        <BoxContainer Orientation="Vertical">

            <!-- Species + Status Banner -->
            <PanelContainer Margin="6 4 6 2">
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat BackgroundColor="#162016"
                                      BorderColor="#2D4A2D" BorderThickness="1 1 1 1"
                                      ContentMarginLeftOverride="10"
                                      ContentMarginTopOverride="8"
                                      ContentMarginBottomOverride="8"
                                      ContentMarginRightOverride="10"/>
                </PanelContainer.PanelOverride>
                <BoxContainer Orientation="Horizontal">
                    <BoxContainer Orientation="Vertical" HorizontalExpand="True">
                        <Label Name="SpeciesLabel" StyleClasses="LabelHeadingBig" />
                        <Label Name="StatusLabel" StyleClasses="LabelSubText" Margin="0 2 0 0" />
                    </BoxContainer>
                    <BoxContainer Orientation="Vertical" VerticalAlignment="Center">
                        <Label Name="HealthBarLabel" HorizontalAlignment="Right" />
                    </BoxContainer>
                </BoxContainer>
            </PanelContainer>

            <!-- Vitals Row (compact horizontal bars) -->
            <BoxContainer Orientation="Vertical" Margin="6 2 6 0">
                <controls:StripeBack>
                    <BoxContainer Orientation="Vertical" Margin="6 4">
                        <GridContainer Name="VitalsGrid" Columns="4" />
                    </BoxContainer>
                </controls:StripeBack>
            </BoxContainer>

            <!-- Section: Stats -->
            <BoxContainer Orientation="Vertical" Margin="6 6 6 0">
                <PanelContainer>
                    <PanelContainer.PanelOverride>
                        <gfx:StyleBoxFlat BackgroundColor="#1A1A2E"
                                          ContentMarginLeftOverride="6"
                                          ContentMarginTopOverride="3"
                                          ContentMarginBottomOverride="3"
                                          ContentMarginRightOverride="6"/>
                    </PanelContainer.PanelOverride>
                    <Label Text="{Loc 'capibara-plant-analyzer-stats-header'}"
                           StyleClasses="LabelKeyText" />
                </PanelContainer>
                <BoxContainer Orientation="Vertical" Margin="4 4 4 0">
                    <GridContainer Name="StatsGrid" Columns="4" />
                </BoxContainer>
            </BoxContainer>

            <!-- Section: Environment -->
            <BoxContainer Orientation="Vertical" Margin="6 6 6 0">
                <PanelContainer>
                    <PanelContainer.PanelOverride>
                        <gfx:StyleBoxFlat BackgroundColor="#1A1A2E"
                                          ContentMarginLeftOverride="6"
                                          ContentMarginTopOverride="3"
                                          ContentMarginBottomOverride="3"
                                          ContentMarginRightOverride="6"/>
                    </PanelContainer.PanelOverride>
                    <Label Text="{Loc 'capibara-plant-analyzer-env-header'}"
                           StyleClasses="LabelKeyText" />
                </PanelContainer>
                <BoxContainer Orientation="Vertical" Margin="4 4 4 0">
                    <GridContainer Name="EnvGrid" Columns="4" />
                </BoxContainer>
            </BoxContainer>

            <!-- Section: Mutation -->
            <BoxContainer Orientation="Vertical" Margin="6 6 6 0">
                <PanelContainer>
                    <PanelContainer.PanelOverride>
                        <gfx:StyleBoxFlat BackgroundColor="#2E2E1A"
                                          ContentMarginLeftOverride="6"
                                          ContentMarginTopOverride="3"
                                          ContentMarginBottomOverride="3"
                                          ContentMarginRightOverride="6"/>
                    </PanelContainer.PanelOverride>
                    <Label Text="{Loc 'capibara-plant-analyzer-mutation-header'}"
                           StyleClasses="LabelKeyText" />
                </PanelContainer>
                <BoxContainer Orientation="Vertical" Margin="4 4 4 0">
                    <GridContainer Name="MutationGrid" Columns="4" />
                </BoxContainer>
            </BoxContainer>

            <!-- Section: Chemistry -->
            <BoxContainer Orientation="Vertical" Margin="6 6 6 0">
                <PanelContainer>
                    <PanelContainer.PanelOverride>
                        <gfx:StyleBoxFlat BackgroundColor="#1A2E1A"
                                          ContentMarginLeftOverride="6"
                                          ContentMarginTopOverride="3"
                                          ContentMarginBottomOverride="3"
                                          ContentMarginRightOverride="6"/>
                    </PanelContainer.PanelOverride>
                    <Label Text="{Loc 'capibara-plant-analyzer-chem-header'}"
                           StyleClasses="LabelKeyText" />
                </PanelContainer>
                <BoxContainer Name="ChemContainer" Orientation="Vertical" Margin="4 4 4 0" />
            </BoxContainer>

            <!-- Section: Genome -->
            <BoxContainer Name="GenomeSection" Orientation="Vertical" Margin="6 6 6 0">
                <PanelContainer>
                    <PanelContainer.PanelOverride>
                        <gfx:StyleBoxFlat BackgroundColor="#2E1A2E"
                                          ContentMarginLeftOverride="6"
                                          ContentMarginTopOverride="3"
                                          ContentMarginBottomOverride="3"
                                          ContentMarginRightOverride="6"/>
                    </PanelContainer.PanelOverride>
                    <BoxContainer Orientation="Horizontal">
                        <Label Text="{Loc 'capibara-seed-analyzer-genome-header'}"
                               StyleClasses="LabelKeyText" HorizontalExpand="True" />
                        <Label Name="InstabilityLabel" />
                    </BoxContainer>
                </PanelContainer>
                <BoxContainer Name="GeneSlotsContainer" Orientation="Vertical" Margin="4 4 4 0" />
            </BoxContainer>

            <!-- Section: Epigenetics -->
            <BoxContainer Orientation="Vertical" Margin="6 6 6 6">
                <PanelContainer>
                    <PanelContainer.PanelOverride>
                        <gfx:StyleBoxFlat BackgroundColor="#1A2E2E"
                                          ContentMarginLeftOverride="6"
                                          ContentMarginTopOverride="3"
                                          ContentMarginBottomOverride="3"
                                          ContentMarginRightOverride="6"/>
                    </PanelContainer.PanelOverride>
                    <Label Text="{Loc 'capibara-seed-analyzer-epigenetics-header'}"
                           StyleClasses="LabelKeyText" />
                </PanelContainer>
                <BoxContainer Name="EpigeneticsContainer" Orientation="Vertical" Margin="4 4 4 0" />
                <Label Name="NoEpigeneticsLabel"
                       Text="{Loc 'capibara-seed-analyzer-no-epigenetics'}"
                       StyleClasses="LabelSubText"
                       Margin="4 2 0 0" />
            </BoxContainer>

        </BoxContainer>
    </ScrollContainer>
</controls:FancyWindow>
